# WhatBot WhatsApp Business Integration Platform Environment Configuration
# NOTE: Store secrets only in your local .env file. Never commit real credentials.

# Server Port
PORT=5000

# Mode: 'demo' (sandbox simulation without real credentials) or 'live' (Meta WhatsApp Cloud API)
WHATSAPP_MODE=demo

# MongoDB Connection String (defaults to local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/whatsapp_chatbot

# JWT Secret Key for dashboard authentication
JWT_SECRET=your_jwt_secret_key_change_in_production_2026

# ==============================================================================
# Meta WhatsApp Cloud API Credentials (Primary - Recommended)
# Precedence Rule: WHATSAPP_* variables take precedence over legacy META_* variables.
# ==============================================================================

# Official WhatsApp Cloud API Permanent System User Access Token or 24hr Temporary Token
# (From Meta App Dashboard > WhatsApp > API Setup or Business Manager System Users)
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token_here

# WhatsApp Business Phone Number ID (from WhatsApp > API Setup in Meta Developer Dashboard)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Custom Webhook Verification Token
# Must EXACTLY match the "Verify Token" field configured in Meta App Dashboard > WhatsApp > Configuration
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token_here

# Meta Graph API Version (e.g. v20.0 or v21.0)
WHATSAPP_API_VERSION=v20.0

# Optional: Meta App Secret (used for verifying incoming webhook X-Hub-Signature-256 header)
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# Optional: WhatsApp Business Account ID (WABA ID)
WHATSAPP_WABA_ID=your_waba_account_id_here

# ==============================================================================
# Legacy / Backward Compatibility Aliases
# If both WHATSAPP_* and META_* are specified with conflicting values, WHATSAPP_* is used.
# ==============================================================================
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=
META_WABA_ID=
